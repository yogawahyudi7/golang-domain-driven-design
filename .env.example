# Environment variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golang_domain_driven_design
DB_SSLMODE=disable

# Server configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# Logger Configuration - Best Practices
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=both
LOG_PRETTY_PRINT=true
LOG_DIR=logs
LOG_APP_FILE=app.log
LOG_ERROR_FILE=error.log
LOG_ACCESS_FILE=access.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true
LOG_DATE_FORMAT=2006-01-02

# Application environment
APP_ENV=development
APP_NAME=golang-domain-driven-design
